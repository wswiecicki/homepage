---
import '@glidejs/glide/dist/css/glide.core.min.css';
import '@glidejs/glide/dist/css/glide.theme.min.css';

interface Props {
    technologies: { name: string; logo: string }[];
}

const { technologies } = Astro.props;
---

<div class="tech-carousel-container">
    <div class="glide">
        <div class="glide__track" data-glide-el="track">
            <ul class="glide__slides">
                {
                    technologies.map((tech) => (
                        <li class="glide__slide">
                            <div class="carousel-item">
                                <img src={tech.logo} alt={`${tech.name} logo`} width="150" height="150" />
                                <span>{tech.name}</span>
                            </div>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</div>

<script>
    import Glide from '@glidejs/glide';

    document.addEventListener('astro:page-load', () => {
        const carousels = document.querySelectorAll('.glide');

        carousels.forEach((carousel) => {
            new Glide(carousel, {
                type: 'carousel',
                perView: 5,
                autoplay: true,
                hoverpause: true,
                animationTimingFunc: 'linear(0, 1)',
                animationDuration: 4000,
                gap: 20,
                breakpoints: {
                    1024: {
                        perView: 4,
                    },
                    768: {
                        perView: 3,
                    },
                    480: {
                        perView: 1,
                    },
                },
            }).mount();
        });
    });
</script>

<style>
    .tech-carousel-container {
        width: calc(100% - 2rem);
        margin: 2rem auto;
        overflow: hidden;
        position: relative;
        background: linear-gradient(
            to right,
            var(--color-bg-item-translucent) 0%,
            rgba(255, 255, 255, 0.1) 50%,
            var(--color-bg-item-translucent) 100%
        );
        border: 1px solid var(--color-border-item-translucent);
        border-radius: 12px;
        box-sizing: border-box;
        padding: 1rem;
        backdrop-filter: blur(4px);
    }

    .carousel-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 0.5rem 1.5rem;
        white-space: nowrap;
        min-height: 100px;
        text-align: center;
        border-radius: 8px;
        border: 1px solid transparent;
        transition: all 0.3s ease;
    }

    .carousel-item:hover {
        border: 1px solid var(--color-border-item-translucent);
        background-color: rgba(255, 255, 255, 0.05);
    }

    .carousel-item img {
        margin-bottom: 0.5rem;
        object-fit: contain;
        transition: filter 0.3s ease;
    }

    .carousel-item span {
        font-size: 0.9rem;
        color: var(--text-color-secondary, #cccccc);
    }

    .carousel-item:hover img {
        filter: grayscale(0%) opacity(100%);
    }

    .glide__arrow {
        background-color: rgba(255, 255, 255, 0.1);
        border: 1px solid var(--color-border-item-translucent);
        color: var(--text-color-secondary, #cccccc);
        padding: 0.5rem;
        border-radius: 50%;
        transition: all 0.3s ease;
    }

    .glide__bullet--active {
        background-color: rgba(255, 255, 255, 0.8);
    }
</style>
