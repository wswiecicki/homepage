---
import { render } from 'astro:content';
import { postPath, tagSlug, type Post } from '@lib/blog';

export interface Props {
    post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
const url = postPath(post);
---

<article class="post">
    <section class="title">
        <a href={url}><h2 class="post-title">{post.data.title}</h2></a>
        <p class="post-date">
            Published on: {post.data.pubDate.toLocaleDateString('en-GB', {
                year: 'numeric', month: 'long', day: 'numeric',
            })}
        </p>
    </section>
    <section class="content"><Content /></section>
    {post.data.tags.length > 0 && (
        <ul class="tags">
            {post.data.tags.map((tag) => (
                <li><a href={`/blog/tags/${tagSlug(tag)}/`}>{tag}</a></li>
            ))}
        </ul>
    )}
    <section class="post-navigation">
        <a href={url}><p class="read-more">Read more</p></a>
        <p class="author">~ {post.data.author}</p>
    </section>
</article>

<style>
    .post {
        min-width: 70%;
        max-width: 95%;
        margin: 2rem auto;
        padding: 1rem;
        border: 1px solid var(--color-border-item);
        border-radius: 0 16px 16px 16px;
        background-color: var(--color-bg-post-translucent);
    }

    .title {
        display: flex;
        align-content: flex-start;
        justify-content: space-between;
        flex-wrap: wrap-reverse;
        margin: 0;
    }

    .post-navigation {
        display: flex;
        justify-content: space-between;
        margin-block-start: 0em;
        margin-block-end: 0em;
    }

    .author {
        text-align: right;
    }

    .content {
        max-height: 16rem;
        overflow: hidden;
        mask-image: linear-gradient(to bottom, black 80%, transparent 100%);
    }

    .post-title {
        -webkit-transition: 300ms;
        transition: 300ms;
    }

    .post-title:hover {
        text-shadow: 0 0 6px var(--color-text-shadow-hover);
    }

    a {
        text-decoration: underline;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        list-style: none;
        padding: 0;
        margin: 0.5rem 0;
    }
    .tags a {
        font-family: 'Ubuntu Mono', monospace;
        font-size: 0.85em;
        padding: 0.15rem 0.6rem;
        border: 1px solid var(--color-border-item);
        border-radius: 999px;
        text-decoration: none;
    }
    .tags a:hover {
        background-color: var(--color-bg-hover);
    }
</style>
