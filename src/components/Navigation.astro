---
import Hamburger from '@components/Hamburger.astro';

const pageOrder = {
    '/': 'Home',
    '/projects': 'Projects',
    '/technologies': 'Technologies',
    '/tools': 'Tools',
    '/blog': 'Blog',
    '/about': 'About',
};
const orderedKeys = Object.keys(pageOrder);
const allPageFiles = import.meta.glob('../pages/*.astro');

const allLinks = Object.keys(allPageFiles).map((filePath) => {
    const fileName = filePath.split('/').pop()?.replace('.astro', '');
    const url = fileName === 'index' ? '/' : `/${fileName}`;
    return url;
});

const capitalize = (word: string) => word && String(word[0]).toUpperCase() + String(word).slice(1);

const navLinks = [
    ...orderedKeys.map((url) => ({
        url,
        name: pageOrder[url as keyof typeof pageOrder],
    })),

    ...allLinks
        .filter((url) => !orderedKeys.includes(url))
        .sort()
        .map((url) => ({
            url,
            name: capitalize(url.replace('/', '')),
        })),
];
---

<nav transition:animate="none">
    <button class="menu-button">Menu</button>
    <Hamburger />
    <ul class="nav-links">
        {
            navLinks.map((link) => (
                <li>
                    <a href={link.url}>{link.name}</a>
                </li>
            ))
        }
    </ul>
</nav>

<script>
    const menuItems = ['.hamburger', '.menu-button'];

    const setListener = (menuItem: string) => {
        document.querySelector(menuItem)?.addEventListener('click', () => {
            document.querySelector('.nav-links')?.classList.toggle('expanded');
        });
    };
    menuItems.forEach((menuItem) => setListener(menuItem));

    document.addEventListener('astro:after-swap', () => menuItems.forEach((menuItem) => setListener(menuItem)));
</script>

<style>
    nav {
        padding: 1rem;
        display: flex;
        justify-content: flex-end;
        flex-wrap: wrap;
        border: 1px solid var(--color-border-item);
        border-top: 0;
        border-radius: 0 0 8px 8px;
        position: relative;
    }

    nav::before {
        content: '';
        position: absolute;
        inset: 0;
        z-index: -1;
        backdrop-filter: blur(2px);
        border-radius: inherit;
    }

    ul {
        visibility: hidden;
        opacity: 0;
        position: absolute;
        list-style-type: none;
        -webkit-transition:
            opacity 300ms,
            visibility 300ms;
        transition:
            opacity 300ms,
            visibility 300ms;
        margin: 0;
        padding: 1rem 2rem 1.5rem;
        top: 100%;
        right: 0;
    }

    ul.expanded {
        visibility: visible;
        opacity: 1;
        border: 1px solid var(--color-border-item);
        border-radius: 8px;
        border-top-left-radius: 0;
        backdrop-filter: blur(1px);
    }

    nav,
    ul.expanded {
        background-color: var(--color-bg-post-translucent);
        z-index: 1;
    }

    ul::before {
        content: '';
        position: absolute;
        inset: 0;
        z-index: -1;
        backdrop-filter: blur(1px);
        border-radius: inherit;
    }

    li {
        padding: 0.5rem;
        padding-right: 0;
        text-align: right;
        border-bottom: 1px solid var(--color-border-item);
    }

    button:hover,
    li:hover {
        text-shadow: 0 0 6px var(--color-text-shadow-hover);
    }

    button {
        font-size: 1.2rem;
    }
</style>
