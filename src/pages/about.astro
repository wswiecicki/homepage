---
import PageBase from '../layouts/PageBase.astro';
import Summary from './content/about/summary.md';
import Current from './content/about/current.md';
import Approach from './content/about/approach.md';
import Philosophy from './content/about/philosophy.md';
---

<PageBase pageTitle="Wojciech Święcicki - homepage">
    <section>
        <div class="main-content">
            <header>
                <h1>About me</h1>
            </header>
            <div class="about-main">
                <div class="about-text">
                    <div class="para-block"><Summary /></div>
                    <div class="para-block"><Current /></div>
                    <div class="para-block"><Approach /></div>
                    <div class="para-block"><Philosophy /></div>
                </div>

                <address>
                    <hr />
                    <p>Should you like to contact me, drop me an email:</p>
                    <a href="mailto:wojciech.swiecicki1@gmail.com">Wojciech Święcicki</a>
                </address>
            </div>
        </div>
    </section>

    <style>
        section {
            max-width: 1280px;
            margin: 0 auto 1rem;
            margin: 0 auto 1rem;
            border: 1px solid #b1ada350;
            padding: 0rem;
            padding-top: auto;
            border-radius: 0 0 0 16px;
            border-top: none;
            backdrop-filter: blur(2px);
            background-color: rgba(20, 20, 20, 0.6);
            display: flex;
            align-items: center;
            height: 70%;
        }
        @media (min-width: 786px) {
            section {
                padding: 1rem;
            }
            /* address hr {
                display: none;
            } */
        }

        .main-content {
        }

        h1 {
            text-align: center;
        }

        .about-main {
            min-width: 40%;
            margin: 2rem 2rem;
            border-radius: 0;
            display: flex;
            flex-direction: row;
            flex-wrap: wrap;
        }

        .about-text {
            margin: unset;
            padding: 0 1rem;
        }

        address {
            margin: unset;
            padding: 1rem;
            width: 100%;
        }

        header {
            text-shadow: 0 0 12px #ada175a0;
        }

        a {
            text-decoration: underline;
        }
        .about-text {
            display: flex;
            flex-direction: column;
            gap: 0;
            padding: 0;
        }

        .para-block {
            display: flex;
            flex-direction: column;
            padding: 1rem;
            line-height: 1.4;
        }

        .para-block hr {
            border: none;
            border-top: 1px solid #b1ada3;
            margin: 1rem 0 0 0;
        }

        @media (min-width: 786px) {
            .about-text {
                flex-direction: row;
            }

            .para-block {
                flex: 1;
                padding: 1rem;
                border-left: 1px solid #b1ada3;
            }

            .para-block:first-child {
                border-left: none;
            }

            .para-block hr {
                display: none;
            }
        }
        .about-main > hr {
            border: none;
            border-top: 1px solid #b1ada3;
            margin: 1rem 0;
        }
    </style>
</PageBase>
