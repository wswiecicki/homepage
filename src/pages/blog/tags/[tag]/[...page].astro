---
import type { GetStaticPathsOptions, Page } from 'astro';
import PageBase from '@layouts/PageBase.astro';
import PostCard from '@components/PostCard.astro';
import { getTags, getPostsByTag, type Post } from '@lib/blog';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
    const tags = await getTags();
    const pages = await Promise.all(
        tags.map(async (info) => {
            const posts = await getPostsByTag(info.slug);
            return paginate(posts, {
                params: { tag: info.slug },
                props: { tag: info.tag },
                pageSize: 5,
            });
        })
    );
    return pages.flat();
}

interface Props {
    page: Page<Post>;
    tag: string;
}
const { page, tag } = Astro.props;
---

<PageBase
    title={page.currentPage === 1 ? `Posts tagged "${tag}"` : `Posts tagged "${tag}" — page ${page.currentPage}`}
    description={`Writing on ${tag} — AI validation, testing agentic systems and quality engineering.`}
    noindex={true}
>
    <section class="post-list">
        <h1>Tagged: {tag}</h1>
        <p class="back"><a href="/blog/tags/">All tags</a> · <a href="/blog/">All posts</a></p>
        {page.data.map((post) => <PostCard post={post} />)}
        <nav class="pagination-nav">
            {page.url.prev ? <a href={page.url.prev}>Back</a> : <div class="nav-placeholder" />}
            <span>Page {page.currentPage} of {page.lastPage}</span>
            {page.url.next ? <a href={page.url.next}>Next</a> : <div class="nav-placeholder" />}
        </nav>
    </section>
</PageBase>

<style>
    .post-list {
        max-width: 1280px;
        margin: 0 auto 1rem;
        border: 1px solid var(--color-border-item-translucent);
        padding: 1rem;
        border-radius: 0 0 0 16px;
        border-top: none;
        backdrop-filter: blur(2px);
        background-color: var(--color-bg-post-translucent);
    }

    h1 {
        text-align: center;
    }

    .back {
        text-align: center;
    }
    .back a {
        text-decoration: underline;
    }

    .pagination-nav {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        margin-top: 2rem;
        padding: 1rem;
        border-top: 1px solid var(--color-border-item);
    }

    .pagination-nav > *:nth-child(1) {
        justify-self: start;
    }
    .pagination-nav > *:nth-child(2) {
        justify-self: center;
    }
    .pagination-nav > *:nth-child(3) {
        justify-self: end;
    }

    .nav-placeholder {
        visibility: hidden;
        padding: 0.5rem 1rem;
        border: 1px solid transparent;
    }

    .pagination-nav a {
        text-decoration: none;
        padding: 0.5rem 1rem;
        border: 1px solid var(--color-border-item);
        border-radius: 4px;
        transition: background-color 0.3s;
    }

    .pagination-nav a:hover {
        background-color: var(--color-bg-hover);
    }
</style>
