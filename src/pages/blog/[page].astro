---
import { getCollection, type CollectionEntry } from 'astro:content';
import type { GetStaticPathsOptions, Page } from 'astro';
import PageBase from '@layouts/PageBase.astro';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
    const pageSize = 5;
    const allPosts: CollectionEntry<'blog'>[] = (await getCollection('blog')).sort(
        (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
    );
    return paginate(allPosts, { pageSize });
}

const { page }: { page: Page<CollectionEntry<'blog'>> } = Astro.props;
---

<PageBase pageTitle={`Blog - Page ${page.currentPage}`}>
    <section class="post-list">
        <h1>Blog posts</h1>
        {
            await Promise.all(
                page.data.map(async (post) => {
                    const { Content } = await post.render();
                    const postUrl = `/blog/${post.slug}/`;
                    return (
                        <article class="post">
                            <section class="title">
                                <a href={postUrl}>
                                    <h2 class="post-title">{post.data.title}</h2>
                                </a>
                                <p class="post-date">
                                    Published on:{' '}
                                    {post.data.pubDate.toLocaleDateString('en-US', {
                                        year: 'numeric',
                                        month: 'long',
                                        day: 'numeric',
                                    })}
                                </p>
                            </section>
                            <section class="content">
                                <Content />
                            </section>
                            <section class="post-navigation">
                                <a href={postUrl}>
                                    <p class="read-more">Read more</p>
                                </a>
                                <p class="author">~ {post.data.author}</p>
                            </section>
                        </article>
                    );
                })
            )
        }

        <nav class="pagination-nav">
            {page.url.prev ? <a href={page.url.prev}>Back</a> : <div class="nav-placeholder" />}
            <span> Page {page.currentPage} of {page.lastPage} </span>
            {page.url.next ? <a href={page.url.next}>Next</a> : <div class="nav-placeholder" />}
        </nav>
    </section>
</PageBase>

<style>
    .post-list {
        max-width: 1280px;
        margin: 0 auto 1rem;
        border: 1px solid var(--color-border-item-translucent);
        padding: 1rem;
        border-radius: 0 0 0 16px;
        border-top: none;
        backdrop-filter: blur(2px);
        background-color: var(--color-bg-post-translucent);
    }

    h1 {
        text-align: center;
    }

    .post {
        min-width: 70%;
        max-width: 95%;
        margin: 2rem auto;
        padding: 1rem;
        border: 1px solid var(--color-border-item);
        border-radius: 0 16px 16px 16px;
        background-color: var(--color-bg-post-translucent);
    }

    .title {
        display: flex;
        align-content: flex-start;
        justify-content: space-between;
        flex-wrap: wrap-reverse;
        margin: 0;
    }

    .post-navigation {
        display: flex;
        justify-content: space-between;
        margin-block-start: 0em;
        margin-block-end: 0em;
    }

    .author {
        text-align: right;
    }

    .content {
        max-height: 16rem;
        overflow: hidden;
        mask-image: linear-gradient(to bottom, black 80%, transparent 100%);
    }

    .post-title {
        -webkit-transition: 300ms;
        transition: 300ms;
    }

    .post-title:hover {
        text-shadow: 0 0 6px var(--color-text-shadow-hover);
    }

    a {
        text-decoration: underline;
    }

    .pagination-nav {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        margin-top: 2rem;
        padding: 1rem;
        border-top: 1px solid var(--color-border-item);
    }

    .pagination-nav > *:nth-child(1) {
        justify-self: start;
    }
    .pagination-nav > *:nth-child(2) {
        justify-self: center;
    }
    .pagination-nav > *:nth-child(3) {
        justify-self: end;
    }

    .nav-placeholder {
        visibility: hidden;
        padding: 0.5rem 1rem;
        border: 1px solid transparent;
    }

    .pagination-nav a {
        text-decoration: none;
        padding: 0.5rem 1rem;
        border: 1px solid var(--color-border-item);
        border-radius: 4px;
        transition: background-color 0.3s;
    }

    .pagination-nav a:hover {
        background-color: var(--color-bg-hover);
    }
</style>
