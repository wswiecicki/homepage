---
import PageBase from '@layouts/PageBase.astro';
import JsonFormatterComponent from '@components/JsonFormatter.astro';
---

<PageBase pageTitle="JSON Formatter">
    <section class="tool-page">
        <h1>JSON Formatter</h1>
        <p class="tool-intro">
            A browser-based tool that formats and validates JSON data. This tool works entirely in your browser - no
            data is sent to any server.
        </p>

        <JsonFormatterComponent />
    </section>
</PageBase>

<style>
    .tool-page {
        max-width: 1280px;
        margin: 0 auto 1rem;
        border: 1px solid #b1ada350;
        padding: 1rem;
        border-radius: 0 0 0 16px;
        border-top: none;
        backdrop-filter: blur(2px);
    }

    h1 {
        text-align: center;
        margin-bottom: 0.5rem;
    }

    .tool-intro {
        max-width: 800px;
        margin: 0 auto 2rem;
        font-size: 1.1rem;
        line-height: 1.5;
        color: #b1ada3;
        text-align: center;
    }
</style>
