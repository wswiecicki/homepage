---
import PageBase from '../layouts/PageBase.astro';
---

<PageBase pageTitle="Wojciech Święcicki - homepage">
    <header>
        <h1>Wojciech Święcicki</h1>
        <h2>Lead SDET / QAOps</h2>
        <p>Improving quality through automation</p>
    </header>
</PageBase>

<style>
    header {
        margin: 2rem;
        position: absolute;
        bottom: 0;
        font-style: normal;
        text-shadow: 0 0 8px #b1ada350;
    }
    p {
        padding: 1rem 0;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const navLinks = document.querySelector('.nav-links');
        if (navLinks) {
            navLinks.classList.add('expanded');
        }
        const hamburger = document.querySelector('.hamburger');
        const menuButton = document.querySelector('.menu-button');
        if (hamburger) {
            hamburger.classList.add('attention-pulse');
        }
        if (menuButton) {
            menuButton.classList.add('attention-pulse');
        }
    });
</script>
