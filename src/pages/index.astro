---
import PageBase from '../layouts/PageBase.astro';
---

<PageBase pageTitle="Wojciech Święcicki - homepage">
    <header>
        <h1>Wojciech Święcicki</h1>
        <h2>Lead Platform & Test Engineer</h2>
        <a class="cta" href="/projects">See my work&nbsp;→</a>
    </header>
</PageBase>

<style>
    header {
        margin: 2rem;
        position: absolute;
        bottom: 0;
        font-style: normal;
        text-shadow: 0 0 8px #b1ada350;
    }
    header h1,
    header h2,
    header p {
        margin: 0;
        padding: 0;
    }
    header h2 {
        margin-top: 0.75rem;
    }
    header p {
        margin-top: 1.5rem;
    }
    .cta {
        display: inline-block;
        margin-top: 1.5rem;
        margin-bottom: 1.5rem;
        font-family: 'Ubuntu Mono', monospace;
        font-size: 1rem;
        text-decoration: underline;
        text-underline-offset: 4px;
    }
    .cta:hover {
        text-shadow: 0 0 6px var(--color-text-shadow-hover);
    }
</style>
