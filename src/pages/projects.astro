---
import { getCollection } from 'astro:content';
import PageBase from '@layouts/PageBase.astro';
import ProjectMasonry from '@components/ProjectMasonry.astro';

const allProjects = (await getCollection('projects')).sort(
    (a, b) => (a.data.order ?? Number.POSITIVE_INFINITY) - (b.data.order ?? Number.POSITIVE_INFINITY)
);
---

<PageBase
    title="Projects"
    description="Selected engineering work — AI evaluation harnesses, test automation platforms, and quality tooling across cloud, data and web systems."
>
    <section class="projects-section">
        <h1>My Projects</h1>
        <ProjectMasonry projects={allProjects} />
    </section>
</PageBase>

<style>
    .projects-section {
        max-width: 1280px;
        margin: 0 auto 1rem;
        border: 1px solid #b1ada350;
        padding: 1rem;
        border-radius: 0 0 0 16px;
        border-top: none;
        backdrop-filter: blur(2px);
        background-color: var(--color-bg-post-translucent);
        text-align: center;
    }

    .projects-section h1 {
        margin-bottom: 0.5rem;
    }

    .projects-section p {
        margin-bottom: 2rem;
    }
</style>
