---
import '@styles/global.css';
import '@fontsource/lato';
import '@fontsource/lato/700';
import '@fontsource/ubuntu-mono';
import '@fontsource/ubuntu-mono/700';

import Navigation from '@components/Navigation.astro';
import Seo, { type Props as SeoProps } from '@components/Seo.astro';
import { ClientRouter } from 'astro:transitions';

export type Props = SeoProps;
const seo = Astro.props;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <Seo {...seo} />
    </head>
    <body>
        <canvas></canvas>
        <Navigation />
        <main transition:animate="slide">
            <slot />
        </main>
        <ClientRouter />
        <footer>
            <p>© Wojciech Swiecicki 2025</p>
        </footer>
    </body>
    <script is:inline data-goatcounter="https://wswiecicki.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
    <script>
        import '@scripts/main.ts';
    </script>
</html>

<style is:global>
    html {
        font-family: 'Lato', sans-serif;
    }
    h3,
    h4,
    h5,
    h6,
    p,
    summary,
    address {
        font-family: 'Ubuntu Mono', monospace;
    }

    main {
        padding-bottom: 40px;
    }

    footer {
        position: fixed;
        left: 0;
        bottom: 0;
        width: 100%;
        background-color: var(--color-bg-primary);
        color: var(--color-text-primary);
        text-align: center;
        padding: 8px 8px;
        font-size: 0.8em;
        border-top: 1px solid var(--color-border-item-translucent);
        z-index: 1;
    }

    footer p {
        margin: 0;
        font-family: 'Lato', sans-serif;
    }
</style>
