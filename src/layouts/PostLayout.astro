---
import PageBase from '@layouts/PageBase.astro';

const { frontmatter } = Astro.props;
---

<PageBase pageTitle={frontmatter.title}>
    <h1>Blog post</h1>
    <article class="post">
        <section class="title">
            <h2 class="post-title">{frontmatter.title}</h2>
            <p class="post-date">
                Published on: {
                    frontmatter.pubDate.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })
                }
            </p>
        </section>

        <slot />
        <p class="author">~ {frontmatter.author}</p>
    </article>
</PageBase>

<style>
    h1 {
        text-align: center;
        padding: 16px;
    }
    article {
        max-width: 1280px;
        margin: 1rem auto;
        border: 1px solid var(--color-border-item);
        padding: 1rem;
        border-radius: 16px;
        border-top-left-radius: 0;
        backdrop-filter: blur(2px);
        background-color: var(--color-bg-post-translucent);
    }

    .title {
        display: flex;
        align-content: flex-start;
        justify-content: space-between;
        flex-wrap: wrap-reverse;
        margin: 0;
    }

    .post-title {
        flex-grow: 3;
    }
    .post-date {
        margin-left: auto;
        margin-block-start: 0em;
        margin-block-end: 0em;
    }

    .author {
        text-align: right;
    }

    .post-date,
    .author {
        font-size: 90%;
    }

    @media (min-width: 786px) {
        article {
            padding: 2rem;
        }
    }

    h2 {
        font-size: 180%;
        margin: 1.5rem auto;
    }

    h3 {
        font-size: 300px;
        margin: 1.5rem auto;
    }

    h4 {
        font-size: 140%;
        margin: 1.5rem auto;
    }

    h5 {
        font-size: 120%;
        margin: 1.5rem auto;
    }
</style>
