---
import PageBase from '@layouts/PageBase.astro';
import { blogPostingSchema } from '@lib/schema';
import { tagSlug, type Post } from '@lib/blog';

interface Props {
    post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, author, tags } = post.data;
---

<PageBase
    title={title}
    description={description}
    ogType="article"
    publishedDate={pubDate}
    updatedDate={updatedDate}
    tags={tags}
    jsonLd={[blogPostingSchema(post)]}
>
    <article class="post">
        <section class="title">
            <h1 class="post-title">{title}</h1>
            <p class="post-date">
                Published on: {
                    pubDate.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })
                }
            </p>
        </section>

        <slot />
        {tags.length > 0 && (
            <ul class="tags">
                {tags.map((tag) => (
                    <li><a href={`/blog/tags/${tagSlug(tag)}/`}>{tag}</a></li>
                ))}
            </ul>
        )}
        <p class="author">~ {author}</p>
    </article>
</PageBase>

<style>
    article {
        max-width: 1280px;
        margin: 1rem auto;
        border: 1px solid var(--color-border-item);
        padding: 1rem;
        border-radius: 16px;
        border-top-left-radius: 0;
        backdrop-filter: blur(2px);
        background-color: var(--color-bg-post-translucent);
    }

    .title {
        display: flex;
        align-content: flex-start;
        justify-content: space-between;
        flex-wrap: wrap-reverse;
        margin: 0;
    }

    .post-title {
        flex-grow: 3;
        font-size: 180%;
        margin: 1.5rem auto;
    }
    .post-date {
        margin-left: auto;
        margin-block-start: 0em;
        margin-block-end: 0em;
    }

    .author {
        text-align: right;
    }

    .post-date,
    .author {
        font-size: 90%;
    }

    @media (min-width: 786px) {
        article {
            padding: 2rem;
        }
    }

    h2 {
        font-size: 180%;
        margin: 1.5rem auto;
    }

    h3 {
        font-size: 300px;
        margin: 1.5rem auto;
    }

    h4 {
        font-size: 140%;
        margin: 1.5rem auto;
    }

    h5 {
        font-size: 120%;
        margin: 1.5rem auto;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        list-style: none;
        padding: 0;
        margin: 0.5rem 0;
    }
    .tags a {
        font-family: 'Ubuntu Mono', monospace;
        font-size: 0.85em;
        padding: 0.15rem 0.6rem;
        border: 1px solid var(--color-border-item);
        border-radius: 999px;
        text-decoration: none;
    }
    .tags a:hover {
        background-color: var(--color-bg-hover);
    }
</style>
