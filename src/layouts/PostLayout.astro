---
import PageBase from '@layouts/PageBase.astro';

const { frontmatter } = Astro.props;
---

<PageBase pageTitle={frontmatter.title}>
    <article class="post">
        <section class="title">
            <h2 class="post-title">{frontmatter.title}</h2>
            <p class="post-date">Published on: {frontmatter.pubDate.slice(0, 10)}</p>
        </section>

        <slot />
        <p class="author">~ {frontmatter.author}</p>
    </article>
</PageBase>

<style>
    article {
        min-width: 70%;
        max-width: 85%;
        margin: auto;
        border: 1px solid #b1ada3;
        padding: 1rem;
        margin-top: 1rem;
        border-radius: 16px;
        border-top-left-radius: 0;
        backdrop-filter: blur(2px);
        background-color: rgba(20, 20, 20, 0.5);
    }

    .title {
        display: flex;
        align-content: flex-start;
        justify-content: space-between;
        flex-wrap: wrap-reverse;
        margin: 0;
    }

    .post-title {
        flex-grow: 3;
    }
    .post-date {
        margin-left: auto;
        margin-block-start: 0em;
        margin-block-end: 0em;
    }

    .author {
        text-align: right;
    }

    .post-date,
    .author {
        font-size: 90%;
    }

    @media (min-width: 786px) {
        article {
            padding: 2rem;
        }
    }

    h2 {
        font-size: 180%;
        margin: 1.5rem auto;
        font-family:;
    }
</style>
